# ── Required ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key
FRONTEND_URL=http://localhost:5173        # production: https://wms.task-code.com
COOKIE_SECURE=false                       # production: true

# ── Database access for migrations and backups ────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432)
DATABASE_URL=

# ── Email (alerts, team notices). Same SMTP as Supabase Auth, e.g. Resend ──
SMTP_HOST=                                # smtp.resend.com
SMTP_PORT=465
SMTP_USER=                                # resend
SMTP_PASSWORD=                            # API key
SMTP_FROM=WMS <no-reply@task-code.com>

# ── AI features (invoice scanning, assistant, message drafts) ─────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=200                        # AI requests per business per day

SALES_MODEL_PATH=models/sales_model.pkl

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=                               # sentry.io → project (Python/FastAPI) → Client Keys
SENTRY_ENVIRONMENT=production

# ── Secrets ───────────────────────────────────────────────────────────────
# Encrypts stored invoicing API keys. Optional: defaults to a key derived from SUPABASE_KEY.
APP_SECRET=
